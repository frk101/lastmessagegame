{
  "name": "last-message",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-screen-capture": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "inkjs": "^2.4.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "prestart": "npm run ink",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ink": "tsx scripts/compile-ink.ts",
    "ink:watch": "tsx scripts/compile-ink.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p __tests__",
    "lint": "expo lint",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" App.tsx",
    "check": "npm run ink && npm run typecheck && npm run lint && npm test -- --silent"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
